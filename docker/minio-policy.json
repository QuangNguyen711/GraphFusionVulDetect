{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::graphfusion-data",
        "arn:aws:s3:::graphfusion-models",
        "arn:aws:s3:::graphfusion-artifacts"
      ]
    },
    {
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::graphfusion-data/*",
        "arn:aws:s3:::graphfusion-models/*",
        "arn:aws:s3:::graphfusion-artifacts/*"
      ]
    }
  ]
}
