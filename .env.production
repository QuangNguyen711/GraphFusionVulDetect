# Production Environment Variables
# GraphFusion - Production Configuration

# AI/ML Configuration
GEMINI_API_KEY="your_production_gemini_api_key"
BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
MODEL_NAME="gemini-2.5-flash"

# Model Paths
EMBEDDING_MODEL_PATH="Quangnguyen711/codebert-solidity-time-dep"
GRAPH_VUL_MODEL_PATH="src/model/best_model_GCN_2L_max.pt"
NODE_VUL_MODEL_PATH="src/model/best_node_classifier_model.pt"

# Database Configuration
MONGODB_URL="mongodb://admin:production_password@mongodb:27017/graphfusion?authSource=admin"
MONGODB_HOST="mongodb"
MONGODB_PORT="27017"
MONGODB_DATABASE="graphfusion"
MONGODB_USERNAME="admin"
MONGODB_PASSWORD="production_password"

# Redis Configuration
REDIS_URL="redis://redis:6379/0"
REDIS_HOST="redis"
REDIS_PORT="6379"
REDIS_DB="0"
REDIS_PASSWORD="your_redis_password_here"

# MinIO Configuration
MINIO_ENDPOINT="minio:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minio_production_secret_key"
MINIO_SECURE="true"
MINIO_BUCKET_DATA="graphfusion-data"
MINIO_BUCKET_MODELS="graphfusion-models"
MINIO_BUCKET_ARTIFACTS="graphfusion-artifacts"

# Application Configuration
ENVIRONMENT="production"
DEBUG="false"
LOG_LEVEL="warn"
SECRET_KEY="super_secure_secret_key_production"
JWT_SECRET="super_secure_jwt_secret_production"
JWT_EXPIRATION="12h"

# API Configuration
API_HOST="0.0.0.0"
API_PORT="8000"
API_WORKERS="4"
CORS_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"

# File Upload Configuration
MAX_FILE_SIZE="50MB"
ALLOWED_EXTENSIONS=".sol,.txt,.json"
UPLOAD_FOLDER="/data/uploads"

# Cache Configuration
CACHE_TTL="7200"
CACHE_PREFIX="gfd:prod:"

# Security Configuration
BCRYPT_ROUNDS="15"
SESSION_TIMEOUT="900"
RATE_LIMIT_REQUESTS="50"
RATE_LIMIT_WINDOW="900"

# External Services
WEBHOOK_URL="https://your-webhook-endpoint.com/graphfusion"
NOTIFICATION_EMAIL="alerts@yourdomain.com"
SMTP_HOST="smtp.yourdomain.com"
SMTP_PORT="587"
SMTP_USERNAME="noreply@yourdomain.com"
SMTP_PASSWORD="smtp_password"

# Production URLs
FRONTEND_URL="https://yourdomain.com"
BACKEND_URL="https://api.yourdomain.com"

# Monitoring
SENTRY_DSN="https://your-sentry-dsn.com"
NEW_RELIC_LICENSE_KEY="your_newrelic_license"

# SSL/TLS
SSL_ENABLED="true"
SSL_CERT_PATH="/etc/ssl/certs/graphfusion.crt"
SSL_KEY_PATH="/etc/ssl/private/graphfusion.key"
