# Copy this file to .env and fill in your values
# GraphFusion Environment Variables Template

# AI/ML Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
MODEL_NAME="gemini-2.5-flash"

# Model Paths
EMBEDDING_MODEL_PATH="Quangnguyen711/codebert-solidity-time-dep"
GRAPH_VUL_MODEL_PATH="src/model/best_model_GCN_2L_max.pt"
NODE_VUL_MODEL_PATH="src/model/best_node_classifier_model.pt"

# Database Configuration
MONGODB_URL="mongodb://admin:your_password@mongodb:27017/graphfusion?authSource=admin"
MONGODB_HOST="mongodb"
MONGODB_PORT="27017"
MONGODB_DATABASE="graphfusion"
MONGODB_USERNAME="admin"
MONGODB_PASSWORD="your_mongodb_password"

# Redis Configuration
REDIS_URL="redis://redis:6379/0"
REDIS_HOST="redis"
REDIS_PORT="6379"
REDIS_DB="0"
REDIS_PASSWORD=""

# MinIO Configuration
MINIO_ENDPOINT="minio:9000"
MINIO_ACCESS_KEY="your_minio_access_key"
MINIO_SECRET_KEY="your_minio_secret_key"
MINIO_SECURE="false"
MINIO_BUCKET_DATA="graphfusion-data"
MINIO_BUCKET_MODELS="graphfusion-models"
MINIO_BUCKET_ARTIFACTS="graphfusion-artifacts"

# Application Configuration
ENVIRONMENT="development"
DEBUG="true"
LOG_LEVEL="debug"
SECRET_KEY="change_this_secret_key_in_production"
JWT_SECRET="change_this_jwt_secret_in_production"
JWT_EXPIRATION="24h"

# API Configuration
API_HOST="0.0.0.0"
API_PORT="8000"
API_WORKERS="1"
CORS_ORIGINS="http://localhost:3000,http://localhost:8080,http://localhost:5173"

# File Upload Configuration
MAX_FILE_SIZE="100MB"
ALLOWED_EXTENSIONS=".sol,.txt,.json,.py"
UPLOAD_FOLDER="./uploads"

# Cache Configuration
CACHE_TTL="3600"
CACHE_PREFIX="gfd:"

# Security Configuration
BCRYPT_ROUNDS="12"
SESSION_TIMEOUT="1800"
RATE_LIMIT_REQUESTS="100"
RATE_LIMIT_WINDOW="900"

# MongoDB Express Configuration (Optional - for database management)
MONGO_EXPRESS_USERNAME="your_mongo_express_username"
MONGO_EXPRESS_PASSWORD="your_mongo_express_password"
MONGO_EXPRESS_PORT="8081"

# External Services (Optional)
WEBHOOK_URL=""
NOTIFICATION_EMAIL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""

# Development specific
FRONTEND_URL="http://localhost:8080"
BACKEND_URL="http://localhost:8000"
